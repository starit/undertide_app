DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@SOURCE-HOST/SOURCE_DB?sslmode=require"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
# Optional — scripts/translate-proposals.ts (defaults are already high: 250k chars, 32k / 16k max_tokens)
# TRANSLATE_MAX_BODY_CHARS=250000
# TRANSLATE_MAX_TOKENS=32768
# TRANSLATE_MAX_TOKENS_META=16384
# Minimum milliseconds between AI theme generation requests per client IP (POST /api/themes/generate). Default 5000.
THEME_GENERATE_MIN_INTERVAL_MS=5000
TALLY_API_KEY="your-tally-api-key"
TALLY_API_URL="https://api.tally.xyz/query"
# Shared secret for POST /api/revalidate (set in Vercel and on the sync host). The endpoint is disabled when unset.
REVALIDATE_SECRET="generate-with-openssl-rand-hex-32"
# Public site URL the sync scripts call to revalidate the data cache, e.g. https://undertide.xyz
NEXT_PUBLIC_BASE_URL="https://undertide.xyz"
